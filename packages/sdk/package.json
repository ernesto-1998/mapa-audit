{
  "name": "@tnet06/mapa-audit-sdk",
  "version": "0.2.0",
  "description": "Structured audit and business observability SDK for Node.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ernesto-1998/mapa-audit.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ernesto-1998/mapa-audit#readme",
  "bugs": {
    "url": "https://github.com/ernesto-1998/mapa-audit/issues"
  },
  "keywords": [
    "audit",
    "observability",
    "typescript",
    "nodejs",
    "express",
    "fastify",
    "nestjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transports": {
      "types": "./dist/transports/index.d.ts",
      "import": "./dist/transports/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    },
    "./nestjs": {
      "types": "./dist/adapters/nestjs.d.ts",
      "import": "./dist/adapters/nestjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tnet06/mapa-audit-types": "0.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "fastify": "^5.11.0",
    "fastify4": "npm:fastify@^4.29.1",
    "reflect-metadata": "^0.2.0",
    "supertest": "^7.2.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
